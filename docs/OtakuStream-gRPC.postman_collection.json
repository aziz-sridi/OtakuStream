{
  "info": {
    "name": "OtakuStream gRPC",
    "_postman_id": "otakustream-grpc-collection",
    "description": "gRPC requests for all OtakuStream microservices: Auth (50051), Catalog (50052), Watchlist (50053), Review (50054), Notification (50055)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth Service (localhost:50051)",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "GRPC",
            "url": "grpc://localhost:50051/auth.AuthService/Register",
            "body": {
              "mode": "grpc",
              "raw": "{\n  \"username\": \"testuser\",\n  \"email\": \"test@example.com\",\n  \"password\": \"password123\"\n}"
            }
          },
          "response": []
        },
        {
          "name": "Login",
          "request": {
            "method": "GRPC",
            "url": "grpc://localhost:50051/auth.AuthService/Login",
            "body": {
              "mode": "grpc",
              "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"password123\"\n}"
            }
          },
          "response": []
        },
        {
          "name": "ValidateToken",
          "request": {
            "method": "GRPC",
            "url": "grpc://localhost:50051/auth.AuthService/ValidateToken",
            "body": {
              "mode": "grpc",
              "raw": "{\n  \"token\": \"<paste_jwt_token_here>\"\n}"
            }
          },
          "response": []
        },
        {
          "name": "GetUserProfile",
          "request": {
            "method": "GRPC",
            "url": "grpc://localhost:50051/auth.AuthService/GetUserProfile",
            "body": {
              "mode": "grpc",
              "raw": "{\n  \"user_id\": \"<user_id_here>\"\n}"
            }
          },
          "response": []
        },
        {
          "name": "UpdateProfile",
          "request": {
            "method": "GRPC",
            "url": "grpc://localhost:50051/auth.AuthService/UpdateProfile",
            "body": {
              "mode": "grpc",
              "raw": "{\n  \"user_id\": \"<user_id_here>\",\n  \"username\": \"newname\",\n  \"avatar_url\": \"https://example.com/avatar.png\",\n  \"bio\": \"Anime lover\"\n}"
            }
          },
          "response": []
        }
      ]
    },
